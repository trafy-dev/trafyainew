# =====================================================================
# FRONTEND ENVIRONMENT  —  copy this file to  assessment-app/.env
#
#   cp assessment-app/.env.example assessment-app/.env
#
# Vite only exposes variables prefixed with VITE_, and it inlines them
# into the JavaScript bundle at build time. Everything here is PUBLIC and
# readable by anyone who opens the site.
#
# >>> Never put SUPABASE_SERVICE_ROLE_KEY (or any secret) in this file. <<<
#
# Vite reads .env only at startup — restart the dev server after editing.
#
# Windows note: PowerShell's `Set-Content -Encoding utf8` writes a UTF-8 BOM,
# which corrupts the first variable name and makes the app report
# "Supabase isn't configured". Use an editor, or strip it with:
#   sed -i '1s/^\xEF\xBB\xBF//' assessment-app/.env
# =====================================================================


# ---------------------------------------------------------------------
# REQUIRED — without these the login screen shows a config warning and
# both Google and email sign-in are disabled.
# Supabase Dashboard > Project Settings > API
# ---------------------------------------------------------------------

# Same value as SUPABASE_URL in backend/.env
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# "Project API keys" > anon / public — the SAME anon key as the backend.
# This one is meant to be public: it is protected by Row Level Security.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace-me


# ---------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------

# Where the backend API is running. Must match the backend's PORT, and
# this origin must appear in the backend's CORS_ORIGINS.
# Defaults to http://localhost:3000 if omitted.
VITE_API_URL=http://localhost:3000
