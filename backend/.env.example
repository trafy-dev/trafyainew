# =====================================================================
# BACKEND ENVIRONMENT  —  copy this file to  backend/.env  and fill in.
#
#   cp backend/.env.example backend/.env
#
# .env is gitignored; this example file is committed. Never put a real
# key in this file.
#
# Windows note: if you create .env with PowerShell's `Set-Content -Encoding utf8`
# it writes a UTF-8 BOM, which corrupts the FIRST variable name. Use an editor,
# or `Set-Content -Encoding ascii`, or strip it with:
#   sed -i '1s/^\xEF\xBB\xBF//' backend/.env
# =====================================================================


# ---------------------------------------------------------------------
# REQUIRED — the server refuses to start without these three.
# All are at: Supabase Dashboard > Project Settings > API
# ---------------------------------------------------------------------

# "Project URL". Also gives you your project ref (the subdomain), which
# you need for the Google OAuth redirect URI.
SUPABASE_URL=https://your-project-ref.supabase.co

# "Project API keys" > anon / public.
# Safe to expose. Used only to verify a caller's access token.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace-me

# "Project API keys" > service_role  (click "Reveal" to see it).
# SECRET. Bypasses Row Level Security — it is what lets this API read
# correct answers and write scores. Server only; never in any VITE_ var,
# never in the browser, never committed.
# Must be DIFFERENT from the anon key above; the server exits at startup
# if you paste the same value twice.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace-me


# ---------------------------------------------------------------------
# OPTIONAL — sensible defaults shown; omit any line to accept the default.
# ---------------------------------------------------------------------

# Judge0 runs candidates' DSA code against test cases.
# Get a key at https://rapidapi.com/judge0-official/api/judge0-ce
# Leave blank and DSA questions report "evaluation unavailable" and score 0
# (shown honestly to the candidate) instead of being awarded fake points.
# MCQ scoring is unaffected either way.
JUDGE0_API_KEY=
JUDGE0_HOST=judge0-ce.p.rapidapi.com

# Port for this API. Default 3000.
# Keep it clear of any static server you run for the marketing site.
PORT=3000

# development | production
# In production, error responses omit the debug field.
NODE_ENV=development

# Comma-separated origins allowed to call this API and open a socket.
# Must include wherever the React app is served from, or the browser
# blocks every request with a CORS error.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Which row in the `assessments` table to serve. Created by db/schema.sql.
ASSESSMENT_SLUG=cohort-26
